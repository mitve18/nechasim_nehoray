# העתק לקובץ .env ומלא ערכים. אל תעלה את .env ל-git.
# בפרודקשן הערכים מוגדרים ב-Render ← Environment וב-GitHub ← Settings ← Secrets.

# Google Drive: הרשאת קריאה וכתיבה מלאה (scope: https://www.googleapis.com/auth/drive).
# מזהה התיקייה מופיע בכתובת שלה: drive.google.com/drive/folders/<DRIVE_FOLDER_ID>
DRIVE_FOLDER_ID=
# Google Cloud Console ← Credentials ← OAuth client (Desktop app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# הפקה: python scripts/get_refresh_token.py client_secret.json, או OAuth Playground.
# חייב להיות מופק עם ה-scope drive (לא drive.readonly), אחרת הסנכרון ייכשל עם invalid_scope.
GOOGLE_REFRESH_TOKEN=

# platform.openai.com/api-keys. משמש את מודל gpt-4o (דרך Agno) ואת ה-embeddings
OPENAI_API_KEY=

# Neon ← Connection string (postgresql://...?sslmode=require)
DATABASE_URL=

# אופציונלי: סיסמה להעלאת קבצים, "נסה שוב" והפעלת סנכרון מהאתר. בלעדיה הפעולות האלה חסומות.
# הניסוח, הדוחות ופאנל הקבצים זמינים לכולם גם בלי סיסמה.
APP_PASSWORD=

# אופציונלי: כפתור "⟳ סנכרון" באתר. בלעדיהם הכפתור מוסתר.
# GitHub ← Settings ← Developer settings ← Fine-grained tokens: רק ל-repo הזה, Actions: Read and write
GH_DISPATCH_TOKEN=
# owner/repo, למשל mitve18/nechasim_nehoray
GH_REPO=

# אופציונלי: נתיב ל-tesseract.exe אם הוא לא ב-PATH
# TESSERACT_CMD=
